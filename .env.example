# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Cryptographic secret for signing session tokens (optional; falls back to random bytes at runtime).
SESSION_SECRET=

# ADMIN_BOOTSTRAP_PASSCODE: Optional server-side passcode to claim initial admin access.
ADMIN_BOOTSTRAP_PASSCODE=

# Payment Gateways (Server-side only — never expose secrets to client)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
